{
  "expo": {
    "name": "Steda",
    "slug": "Steda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "steda",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.yousef.steda"
    },
    "android": {
      "package": "com.yousef.steda",
      "icon": "./assets/images/icon.png",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#F7F8FA"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#111318",
            "image": "./assets/images/android-icon-foreground.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#4F46E5",
          "sounds": [
            "./assets/sounds/chime.mp3",
            "./assets/sounds/bell.mp3",
            "./assets/sounds/soft-notification.mp3"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
